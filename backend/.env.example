# backend/.env 로 복사해서 사용 (.env는 gitignore - 실제 값 커밋 금지)
# 아래 DB 기본값은 backend/docker-compose.yml 의 MariaDB와 동일 - 도커 쓰면 .env 없이도 부팅됨

# 서버
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MariaDB
DB_URL=jdbc:mariadb://localhost:3306/hangatmap
DB_USER=root
DB_PASS=qwer1234

# 공공데이터포털 서비스 키 - 원본(Decoding) 키를 넣는다 (이중 인코딩 주의)
SERVICE_KEY=your-decoding-key-here

# JWT·인증 코드 시크릿 - 예시값을 그대로 운영에 사용하지 말 것
JWT_SECRET=replace-with-at-least-32-byte-random-secret
APP_AUTH_CODE_HMAC_SECRET=replace-with-base64-encoded-32-byte-random-secret

# Resend SMTP
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_replace-with-resend-api-key
MAIL_FROM=no-reply@your-domain.com
# SMTP HELO/EHLO에 사용할 유효한 호스트명 (로컬 개발 기본값: localhost)
MAIL_SMTP_LOCALHOST=localhost

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Kakao OAuth
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
