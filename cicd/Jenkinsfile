pipeline {
    agent any

    // ────────────────────────── Pipeline 제어 ──────────────────────────

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    // ────────────────────────── 공통 설정 ──────────────────────────

    environment {
        DOCKER_BUILDKIT = '1'

        BACKEND_IMAGE = 'lumisia/hangat-backend'
        FRONTEND_IMAGE = 'lumisia/hangat-frontend'

        FRONTEND_API_BASE_URL = 'https://api.hangatjeju.com'

        HELM_RELEASE = 'hangat'
        K8S_NAMESPACE = 'hangat'
    }

    stages {

        // ────────────────────────── 소스 조회 ──────────────────────────

        stage('Checkout') {
            steps {
                checkout scm

                script {
                    env.DEPLOYMENT_REVISION = sh(
                            script: 'git rev-parse HEAD', returnStdout: true
                    ).trim()
                    String commitHash = sh(
                            script: 'git rev-parse --short=12 HEAD',
                            returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = "${commitHash}-${env.BUILD_NUMBER}"
                }

                echo "배포 이미지 태그: ${env.IMAGE_TAG}"
            }
        }

        // ────────────────────────── 백엔드 검사 ──────────────────────────

        stage('Backend Test') {
            steps {
                sh '''
                    set -eu

                    TEST_CONTAINER="hangat-backend-test-${BUILD_NUMBER}"

                    cleanup() {
                        mkdir -p "$WORKSPACE/backend/build/test-results/test"
                        docker cp \
                          "$TEST_CONTAINER:/workspace/build/test-results/test/." \
                          "$WORKSPACE/backend/build/test-results/test/" \
                          >/dev/null 2>&1 || true
                        docker rm -f "$TEST_CONTAINER" >/dev/null 2>&1 || true
                    }

                    trap cleanup EXIT

                    docker rm -f "$TEST_CONTAINER" >/dev/null 2>&1 || true

                    docker create \
                      --name "$TEST_CONTAINER" \
                      --user "$(id -u):$(id -g)" \
                      --env HOME=/tmp \
                      --env GRADLE_USER_HOME=/tmp/gradle \
                      --workdir /workspace \
                      eclipse-temurin:17-jdk-jammy \
                      sh -c "
                        sed -i 's/\\r$//' gradlew &&
                        chmod +x gradlew &&
                        ./gradlew test --no-daemon
                      "

                    docker cp \
                      "$WORKSPACE/backend/." \
                      "$TEST_CONTAINER:/workspace"

                    docker start --attach "$TEST_CONTAINER"
                '''
            }
        }

        // ────────────────────────── 프론트 검사 ──────────────────────────

        stage('Frontend Test') {
            steps {
                sh '''
                    set -eu

                    TEST_CONTAINER="hangat-frontend-test-${BUILD_NUMBER}"

                    cleanup() {
                        docker rm -f "$TEST_CONTAINER" >/dev/null 2>&1 || true
                    }

                    trap cleanup EXIT
                    docker rm -f "$TEST_CONTAINER" >/dev/null 2>&1 || true

                    docker create \
                      --name "$TEST_CONTAINER" \
                      --user "$(id -u):$(id -g)" \
                      --env HOME=/tmp \
                      --env npm_config_cache=/tmp/npm-cache \
                      --workdir /workspace/frontend \
                      node:22-alpine \
                      sh -c "npm ci && npm run type-check && npm test"

                    # Preserve repository-relative paths used by deployment contract tests.
                    docker cp "$WORKSPACE/frontend/." "$TEST_CONTAINER:/workspace/frontend"
                    docker cp "$WORKSPACE/cicd" "$TEST_CONTAINER:/workspace/cicd"
                    docker cp "$WORKSPACE/backend" "$TEST_CONTAINER:/workspace/backend"
                    docker start --attach "$TEST_CONTAINER"
                '''
            }
        }

        // ────────────────────────── Helm 검사 ──────────────────────────

        stage('Helm Validate') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'hangat-values-private',
                        variable: 'HELM_VALUES_PRIVATE'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        test -f cicd/helm/Chart.yaml
                        test -f cicd/helm/values.yaml
                        test -f cicd/helm/values-oci-k3s.yaml

                        helm lint cicd/helm \
                          --values cicd/helm/values.yaml \
                          --values cicd/helm/values-oci-k3s.yaml \
                          --values "$HELM_VALUES_PRIVATE" \
                          --set-string backend.configEnv.HANGAT_ASYNC_ENABLED=true \
                          --set ingress.swagger.enabled=false

                        helm template "$HELM_RELEASE" cicd/helm \
                          --namespace "$K8S_NAMESPACE" \
                          --values cicd/helm/values.yaml \
                          --values cicd/helm/values-oci-k3s.yaml \
                          --values "$HELM_VALUES_PRIVATE" \
                          --set ingress.swagger.enabled=false \
                          --set-string backend.configEnv.HANGAT_ASYNC_ENABLED=true \
                          > /dev/null

                        # 비활성 기간에도 CronJob 템플릿의 문법 오류를 검사한다.
                        helm template "$HELM_RELEASE" cicd/helm \
                          --namespace "$K8S_NAMESPACE" \
                          --values cicd/helm/values.yaml \
                          --values cicd/helm/values-oci-k3s.yaml \
                          --values "$HELM_VALUES_PRIVATE" \
                          --set ingress.swagger.enabled=false \
                          --set-string backend.configEnv.HANGAT_ASYNC_ENABLED=true \
                          --set batch.enabled=true \
                          --set batch.suspend=true \
                          > /dev/null
                    '''
                }
            }
        }

        // ────────────────────────── 백엔드 이미지 생성 ──────────────────────────

        stage('Build Backend Image') {
            steps {
                sh '''
                    docker build \
                      --file cicd/backend.Dockerfile \
                      --tag "$BACKEND_IMAGE:$IMAGE_TAG" \
                      .
                '''
            }
        }

        // ────────────────────────── 프론트 이미지 생성 ──────────────────────────

        stage('Build Frontend Image') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'hangat-kakao-map-key',
                        variable: 'KAKAO_MAP_KEY'
                    )
                ]) {
                    sh '''
                        set +x

                        test -n "$KAKAO_MAP_KEY"
                        test -n "$FRONTEND_API_BASE_URL"

                        docker build \
                          --build-arg VITE_API_BASE_URL="$FRONTEND_API_BASE_URL" \
                          --build-arg VITE_NOTIFICATIONS_ENABLED=true \
                          --build-arg VITE_ASYNC_COURSES_ENABLED=true \
                          --build-arg VITE_TRIP_ALERTS_ENABLED=true \
                          --build-arg VITE_TRIP_NOTIFICATIONS_ENABLED=true \
                          --secret id=kakao_map_key,env=KAKAO_MAP_KEY \
                          --no-cache \
                          --file cicd/frontend.Dockerfile \
                          --tag "$FRONTEND_IMAGE:$IMAGE_TAG" \
                          .
                    '''
                }
            }
        }

        // ────────────────────────── Docker Hub 업로드 ──────────────────────────

        stage('Push Images') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-lumisia',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x

                        printf '%s' "$DOCKERHUB_TOKEN" |
                          docker login \
                            --username "$DOCKERHUB_USERNAME" \
                            --password-stdin

                        docker tag \
                          "$BACKEND_IMAGE:$IMAGE_TAG" \
                          "$BACKEND_IMAGE:latest"

                        docker tag \
                          "$FRONTEND_IMAGE:$IMAGE_TAG" \
                          "$FRONTEND_IMAGE:latest"

                        docker push "$BACKEND_IMAGE:$IMAGE_TAG"
                        docker push "$BACKEND_IMAGE:latest"

                        docker push "$FRONTEND_IMAGE:$IMAGE_TAG"
                        docker push "$FRONTEND_IMAGE:latest"

                        docker logout
                    '''
                }
            }
        }

        // ────────────────────────── OCI k3s 배포 ──────────────────────────

        stage('Deploy') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'oci-k3s-kubeconfig',
                        variable: 'KUBECONFIG_FILE'
                    ),
                    file(
                        credentialsId: 'hangat-values-private',
                        variable: 'HELM_VALUES_PRIVATE'
                    )
                ]) {
                    sh deploymentScript()
                }
            }
        }
    }

    // ────────────────────────── 실행 결과 정리 ──────────────────────────

    post {
        always {
            // cleanup의 deleteDir 전에 선별된 진단 파일만 보관한다.
            archiveArtifacts(
                artifacts: 'deployment-diagnostics/*.log',
                allowEmptyArchive: true,
                onlyIfSuccessful: false
            )
            junit(
                testResults: 'backend/build/test-results/test/*.xml',
                allowEmptyResults: true
            )

            sh '''
                docker logout >/dev/null 2>&1 || true
            '''
        }

        success {
            echo "Hangat 배포 성공: ${env.IMAGE_TAG}"
        }

        failure {
            echo "Hangat Pipeline 실패: ${env.BUILD_URL}"
        }

        cleanup {
            deleteDir()
        }
    }
}

String deploymentScript() {
    return '''
        set -eu
        set +x
        umask 077
        : "${KUBECONFIG_FILE:?}"
        : "${HELM_VALUES_PRIVATE:?}"
        : "${HELM_RELEASE:?}"
        : "${K8S_NAMESPACE:?}"
        : "${BACKEND_IMAGE:?}"
        : "${FRONTEND_IMAGE:?}"
        : "${IMAGE_TAG:?}"
        : "${DEPLOYMENT_REVISION:?}"
        export KUBECONFIG="$KUBECONFIG_FILE"
        mkdir -p deployment-diagnostics
        selector="app.kubernetes.io/instance=$HELM_RELEASE"

        collect_diagnostics() {
            # Secret/env/Pod YAML/describe와 로그 전문은 보관하지 않는다.
            {
                date -u '+%Y-%m-%dT%H:%M:%SZ'
                kubectl --request-timeout=5s -n "$K8S_NAMESPACE" get deployments -l "$selector" \
                  -o 'custom-columns=NAME:.metadata.name,READY:.status.readyReplicas,DESIRED:.spec.replicas,IMAGE:.spec.template.spec.containers[*].image' 2>/dev/null || echo 'deployment status unavailable'
                kubectl --request-timeout=5s -n "$K8S_NAMESPACE" get pods -l "$selector" \
                  -o 'custom-columns=NAME:.metadata.name,PHASE:.status.phase,READY:.status.containerStatuses[*].ready,RESTARTS:.status.containerStatuses[*].restartCount,WAIT:.status.containerStatuses[*].state.waiting.reason,EXIT:.status.containerStatuses[*].lastState.terminated.exitCode,REASON:.status.containerStatuses[*].lastState.terminated.reason,IMAGE:.spec.containers[*].image' 2>/dev/null || echo 'pod status unavailable'
                kubectl --request-timeout=5s -n "$K8S_NAMESPACE" get cronjobs,jobs -l "$selector" \
                  -o 'custom-columns=KIND:.kind,NAME:.metadata.name,SUSPEND:.spec.suspend,SUCCEEDED:.status.succeeded,FAILED:.status.failed,LAST_SUCCESS:.status.lastSuccessfulTime' 2>/dev/null || echo 'batch status unavailable'
                # event.message에는 URL·자격증명이 들어갈 수 있어 원인 코드만 수집한다.
                kubectl --request-timeout=5s -n "$K8S_NAMESPACE" get events --field-selector=type=Warning \
                  -o 'custom-columns=TIME:.lastTimestamp,KIND:.involvedObject.kind,NAME:.involvedObject.name,REASON:.reason,COUNT:.count' 2>/dev/null || echo 'event status unavailable'
            } >> deployment-diagnostics/deployment-state.log

            pods=$(kubectl --request-timeout=5s -n "$K8S_NAMESPACE" get pods -l "$selector" -o name 2>/dev/null | head -n 10)
            for pod in $pods; do
                for previous in '' '--previous'; do
                    # 파이프에서 바로 예외 클래스명만 추출한다. 원문은 임시 파일에도 쓰지 않는다.
                    types=$(kubectl --request-timeout=5s -n "$K8S_NAMESPACE" logs "$pod" --all-containers=true --pod-running-timeout=1s --tail=150 --limit-bytes=32768 $previous 2>/dev/null \
                      | grep -Eo '([a-zA-Z_][a-zA-Z0-9_]*\\.)+[a-zA-Z_][a-zA-Z0-9_]*(Exception|Error)' | sort -u || true)
                    if [ -n "$types" ]; then
                        printf '%s %s\\n%s\\n' "$pod" "${previous:-current}" "$types" >> deployment-diagnostics/exception-types.log
                    fi
                done
            done
        }

        # --atomic이 실패 Pod를 지우기 전의 상태도 보관한다.
        (
            while :; do
                collect_diagnostics || true
                sleep 10
            done
        ) &
        observer=$!
        cleanup() {
            code=$?
            trap - EXIT
            kill "$observer" 2>/dev/null || true
            wait "$observer" 2>/dev/null || true
            collect_diagnostics || true
            exit "$code"
        }
        trap cleanup EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM

        helm upgrade --install "$HELM_RELEASE" cicd/helm \
          --namespace "$K8S_NAMESPACE" \
          --values cicd/helm/values.yaml \
          --values cicd/helm/values-oci-k3s.yaml \
          --values "$HELM_VALUES_PRIVATE" \
          --set-string backend.configEnv.HANGAT_ASYNC_ENABLED=true \
          --set ingress.swagger.enabled=false \
          --set-string deployment.revision="$DEPLOYMENT_REVISION" \
          --set-string backend.image.repository="$BACKEND_IMAGE" \
          --set-string backend.image.tag="$IMAGE_TAG" \
          --set-string frontend.image.repository="$FRONTEND_IMAGE" \
          --set-string frontend.image.tag="$IMAGE_TAG" \
          --history-max 10 --atomic --wait --timeout 5m

        kubectl --namespace "$K8S_NAMESPACE" rollout status "deployment/$HELM_RELEASE-backend" --timeout=180s
        kubectl --namespace "$K8S_NAMESPACE" rollout status "deployment/$HELM_RELEASE-frontend" --timeout=180s
    '''
}
